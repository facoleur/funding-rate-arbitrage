# Copier sur le VPS vers /etc/caddy/Caddyfile
# Caddy gère le SSL Let's Encrypt automatiquement si un domaine est fourni

# --- Avec domaine + SSL automatique ---
arb.mondomaine.com {
    reverse_proxy /api/* localhost:8001
    reverse_proxy /sse/* localhost:8001 {
        flush_interval -1
    }
    reverse_proxy /* localhost:3000
}

# --- Sans domaine (IP directe, port 80, pas de SSL) ---
# :80 {
#     reverse_proxy /api/* localhost:8001
#     reverse_proxy /sse/* localhost:8001 {
#         flush_interval -1
#     }
#     reverse_proxy /* localhost:3000
# }
